digraph DFA {
rankdir=LR;
node [fontname="Segoe UI"];
entry [shape=point];
entry -> q0;
q0 [shape=doublecircle, label="0: epsilon"];
q1 [shape=doublecircle, label="1: r"];
q2 [shape=doublecircle, label="2: r^-1"];
q3 [shape=doublecircle, label="3: s"];
q4 [shape=box, label="4: REJECT"];
q0 -> q1 [label="r"];
q0 -> q2 [label="r^-1"];
q0 -> q3 [label="s"];
q1 -> q1 [label="r"];
q1 -> q4 [label="r^-1"];
q1 -> q3 [label="s"];
q2 -> q4 [label="r"];
q2 -> q2 [label="r^-1"];
q2 -> q3 [label="s"];
q3 -> q1 [label="r"];
q3 -> q2 [label="r^-1"];
q3 -> q4 [label="s"];
q4 -> q4 [label="r"];
q4 -> q4 [label="r^-1"];
q4 -> q4 [label="s"];
}
