digraph DFA {
rankdir=LR;
node [fontname="Segoe UI"];
entry [shape=point];
entry -> q0;
q0 [shape=doublecircle, label="0: epsilon"];
q1 [shape=doublecircle, label="1: r"];
q2 [shape=doublecircle, label="2: r^-1"];
q3 [shape=doublecircle, label="3: s"];
q4 [shape=doublecircle, label="4: r r"];
q5 [shape=doublecircle, label="5: r s"];
q6 [shape=doublecircle, label="6: r^-1 s"];
q7 [shape=box, label="7: REJECT"];
q0 -> q1 [label="r"];
q0 -> q2 [label="r^-1"];
q0 -> q3 [label="s"];
q1 -> q4 [label="r"];
q1 -> q7 [label="r^-1"];
q1 -> q5 [label="s"];
q2 -> q7 [label="r"];
q2 -> q7 [label="r^-1"];
q2 -> q6 [label="s"];
q3 -> q7 [label="r"];
q3 -> q7 [label="r^-1"];
q3 -> q7 [label="s"];
q4 -> q7 [label="r"];
q4 -> q7 [label="r^-1"];
q4 -> q5 [label="s"];
q5 -> q7 [label="r"];
q5 -> q7 [label="r^-1"];
q5 -> q7 [label="s"];
q6 -> q7 [label="r"];
q6 -> q7 [label="r^-1"];
q6 -> q7 [label="s"];
q7 -> q7 [label="r"];
q7 -> q7 [label="r^-1"];
q7 -> q7 [label="s"];
}
